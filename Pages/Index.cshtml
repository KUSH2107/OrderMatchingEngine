@page
@model WebApplication1.Pages.IndexModel

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Order Matching Engine - Task 2</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<style>
		body {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			min-height: 100vh;
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		}
		.main-container {
			padding: 20px;
		}
		.card {
			border: none;
			border-radius: 10px;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
			margin-bottom: 20px;
		}
		.card-header {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			color: white;
			border-radius: 10px 10px 0 0 !important;
			font-weight: 600;
		}
		.btn-primary {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			border: none;
			border-radius: 5px;
			padding: 8px 20px;
			transition: all 0.3s ease;
		}
		.btn-primary:hover {
			transform: translateY(-2px);
			box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
		}
		.btn-danger {
			border-radius: 5px;
			padding: 8px 15px;
		}
		.btn-info {
			border-radius: 5px;
			padding: 8px 15px;
		}
		.btn-success {
			border-radius: 5px;
			padding: 8px 15px;
		}
		.table {
			font-size: 0.95rem;
		}
		.table thead {
			background: #f8f9fa;
			font-weight: 600;
		}
		.buy-row {
			background-color: rgba(76, 175, 80, 0.1);
		}
		.sell-row {
			background-color: rgba(244, 67, 54, 0.1);
		}
		.badge-buy {
			background-color: #4CAF50;
			color: white;
		}
		.badge-sell {
			background-color: #f44336;
			color: white;
		}
		.section-title {
			color: white;
			margin-bottom: 20px;
			font-weight: 700;
		}
		.loading {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background: rgba(0, 0, 0, 0.5);
			z-index: 9999;
			justify-content: center;
			align-items: center;
		}
		.loading.active {
			display: flex;
		}
		.spinner {
			border: 4px solid rgba(255, 255, 255, 0.3);
			border-top-color: white;
			border-radius: 50%;
			width: 40px;
			height: 40px;
			animation: spin 0.8s linear infinite;
		}
		@@keyframes spin {
			to { transform: rotate(360deg); }
		}
		.position-badge {
			font-size: 1.1rem;
			padding: 10px 15px;
			border-radius: 5px;
			display: inline-block;
			margin: 5px 0;
		}
		.position-flat {
			background-color: #999;
			color: white;
		}
		.position-long {
			background-color: #4CAF50;
			color: white;
		}
		.position-short {
			background-color: #f44336;
			color: white;
		}
		.metric-box {
			background: #f8f9fa;
			padding: 15px;
			border-radius: 5px;
			margin: 10px 0;
			border-left: 4px solid #667eea;
		}
		.metric-label {
			font-size: 0.9rem;
			color: #666;
			font-weight: 600;
			text-transform: uppercase;
		}
		.metric-value {
			font-size: 1.5rem;
			font-weight: bold;
			color: #333;
			margin-top: 5px;
		}
		.pnl-positive {
			color: #4CAF50;
		}
		.pnl-negative {
			color: #f44336;
		}
	</style>
</head>
<body>
	<div class="loading" id="loading">
		<div class="spinner"></div>
	</div>

	<div class="main-container">
		<div class="container-fluid">
			<!-- Header -->
			<div class="mb-4">
				<h1 class="section-title">📊 Order Matching Engine - Task 2 (Position &amp; PnL)</h1>
			</div>

			<div class="row">
				<!-- Left Column: Order Management & Task 2 -->
				<div class="col-lg-6">
					<!-- New Order -->
					<div class="card">
						<div class="card-header">
							➕ Create New Order
						</div>
						<div class="card-body">
							<div class="mb-3">
								<label class="form-label">Order ID</label>
								<input type="text" class="form-control" id="orderId" placeholder="e.g., ORD001">
							</div>
							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label">Side</label>
									<select class="form-select" id="side">
										<option value="BUY">🔵 BUY</option>
										<option value="SELL">🔴 SELL</option>
									</select>
								</div>
								<div class="col-md-6 mb-3">
									<label class="form-label">Price</label>
									<input type="number" class="form-control" id="price" placeholder="100.00" step="0.01">
								</div>
							</div>
							<div class="mb-3">
								<label class="form-label">Quantity</label>
								<input type="number" class="form-control" id="quantity" placeholder="1000" step="1">
							</div>
							<button class="btn btn-primary w-100" onclick="createOrder()">Create Order</button>
						</div>
					</div>

					<!-- Order Actions -->
					<div class="card">
						<div class="card-header">
							⚙️ Order Actions
						</div>
						<div class="card-body">
							<div class="mb-3">
								<label class="form-label">Order ID</label>
								<input type="text" class="form-control" id="actionOrderId" placeholder="e.g., ORD001">
							</div>
							<button class="btn btn-danger w-100 mb-2" onclick="cancelOrder()">❌ Cancel Order</button>
						</div>
					</div>

					<!-- Modify Order -->
					<div class="card">
						<div class="card-header">
							✏️ Modify Order
						</div>
						<div class="card-body">
							<div class="mb-3">
								<label class="form-label">Order ID</label>
								<input type="text" class="form-control" id="modifyOrderId" placeholder="e.g., ORD001">
							</div>
							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label">New Price</label>
									<input type="number" class="form-control" id="modifyPrice" placeholder="100.00" step="0.01">
								</div>
								<div class="col-md-6 mb-3">
									<label class="form-label">New Quantity</label>
									<input type="number" class="form-control" id="modifyQuantity" placeholder="1000" step="1">
								</div>
							</div>
							<button class="btn btn-primary w-100" onclick="modifyOrder()">Modify Order</button>
						</div>
					</div>

					<!-- Task 2: Market Price -->
					<div class="card">
						<div class="card-header">
							💹 Market Price (PRICE Command)
						</div>
						<div class="card-body">
							<div class="mb-3">
								<label class="form-label">Current Market Price</label>
								<input type="number" class="form-control" id="marketPrice" placeholder="100.00" step="0.01" value="100.00">
							</div>
							<button class="btn btn-info w-100" onclick="setMarketPrice()">Update Market Price</button>
						</div>
					</div>

					<!-- Task 2: Manual Fill -->
					<div class="card">
						<div class="card-header">
							📍 Record Fill (FILL Command)
						</div>
						<div class="card-body">
							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label">Buy Order ID</label>
									<input type="text" class="form-control" id="fillBuyOrderId" placeholder="e.g., BUY001">
								</div>
								<div class="col-md-6 mb-3">
									<label class="form-label">Sell Order ID</label>
									<input type="text" class="form-control" id="fillSellOrderId" placeholder="e.g., SELL001">
								</div>
							</div>
							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label">Price</label>
									<input type="number" class="form-control" id="fillPrice" placeholder="100.00" step="0.01">
								</div>
								<div class="col-md-6 mb-3">
									<label class="form-label">Quantity</label>
									<input type="number" class="form-control" id="fillQuantity" placeholder="100" step="1">
								</div>
							</div>
							<button class="btn btn-success w-100" onclick="createFill()">Record Fill</button>
						</div>
					</div>
				</div>

				<!-- Right Column: Order Book & Position Display -->
				<div class="col-lg-6">
					<!-- Position Display (PRINT Command) -->
					<div class="card" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
						<div class="card-header">
							📈 Position &amp; PnL (PRINT Command)
						</div>
						<div class="card-body">
							<div id="positionStatus" class="text-center mb-3">
								<div id="positionBadge" class="position-badge position-flat">FLAT</div>
							</div>
							<div class="row">
								<div class="col-md-6">
									<div class="metric-box">
										<div class="metric-label">Net Qty</div>
										<div class="metric-value" id="netQtyValue">0</div>
									</div>
								</div>
								<div class="col-md-6">
									<div class="metric-box">
										<div class="metric-label">Avg Price</div>
										<div class="metric-value" id="avgPriceValue">0.00</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-md-6">
									<div class="metric-box">
										<div class="metric-label">Realized PnL</div>
										<div class="metric-value" id="realizedPnLValue">0.00</div>
									</div>
								</div>
								<div class="col-md-6">
									<div class="metric-box">
										<div class="metric-label">Unrealized PnL</div>
										<div class="metric-value" id="unrealizedPnLValue">0.00</div>
									</div>
								</div>
							</div>
							<div class="row">
								<div class="col-12">
									<div class="metric-box">
										<div class="metric-label">Total PnL</div>
										<div class="metric-value" id="totalPnLValue">0.00</div>
									</div>
								</div>
							</div>
							<div class="row mt-3">
								<div class="col-12">
									<div class="metric-box">
										<div class="metric-label">Current Market Price</div>
										<div class="metric-value" id="currentPriceValue">100.00</div>
									</div>
								</div>
							</div>
							<button class="btn btn-primary w-100 mt-3" onclick="refreshPosition()">🔄 Refresh Position</button>
						</div>
					</div>

					<!-- Order Book -->
					<div class="card">
						<div class="card-header d-flex justify-content-between align-items-center">
							📋 Order Book
							<button class="btn btn-sm btn-light" onclick="refreshOrderBook()">🔄 Refresh</button>
						</div>
						<div class="card-body">
							<ul class="nav nav-tabs" role="tablist">
								<li class="nav-item">
									<a class="nav-link active" data-bs-toggle="tab" href="#buyOrders">BUY Orders</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" data-bs-toggle="tab" href="#sellOrders">SELL Orders</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" data-bs-toggle="tab" href="#fills">Fills</a>
								</li>
							</ul>

							<div class="tab-content mt-3">
								<!-- BUY Orders Tab -->
								<div class="tab-pane fade show active" id="buyOrders">
									<div class="table-responsive">
										<table class="table table-sm table-hover">
											<thead>
												<tr>
													<th>Order ID</th>
													<th>Price</th>
													<th>Qty</th>
													<th>Filled</th>
													<th>Remaining</th>
													<th>Time</th>
												</tr>
											</thead>
											<tbody id="buyOrdersTable">
												<tr>
													<td colspan="6" class="text-center text-muted">No buy orders</td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>

								<!-- SELL Orders Tab -->
								<div class="tab-pane fade" id="sellOrders">
									<div class="table-responsive">
										<table class="table table-sm table-hover">
											<thead>
												<tr>
													<th>Order ID</th>
													<th>Price</th>
													<th>Qty</th>
													<th>Filled</th>
													<th>Remaining</th>
													<th>Time</th>
												</tr>
											</thead>
											<tbody id="sellOrdersTable">
												<tr>
													<td colspan="6" class="text-center text-muted">No sell orders</td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>

								<!-- Fills Tab -->
								<div class="tab-pane fade" id="fills">
									<div class="table-responsive">
										<table class="table table-sm table-hover">
											<thead>
												<tr>
													<th>Buy Order</th>
													<th>Sell Order</th>
													<th>Price</th>
													<th>Quantity</th>
													<th>Time</th>
												</tr>
											</thead>
											<tbody id="fillsTable">
												<tr>
													<td colspan="5" class="text-center text-muted">No fills</td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Alerts -->
					<div id="alertContainer"></div>
				</div>
			</div>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		const API_URL = '/api/orders';

		function showLoading(show) {
			show = show || true;
			const loading = document.getElementById('loading');
			if (show) {
				loading.classList.add('active');
			} else {
				loading.classList.remove('active');
			}
		}

		function showAlert(message, type) {
			type = type || 'success';
			const alertContainer = document.getElementById('alertContainer');
			const alertId = 'alert-' + Date.now();
			let alert = '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert" id="' + alertId + '">';
			alert += message;
			alert += '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
			alert += '</div>';
			alertContainer.insertAdjacentHTML('beforeend', alert);

			setTimeout(function () {
				const element = document.getElementById(alertId);
				if (element) {
					element.remove();
				}
			}, 5000);
		}

		async function createOrder() {
			const orderId = document.getElementById('orderId').value;
			const side = document.getElementById('side').value;
			const price = parseFloat(document.getElementById('price').value);
			const quantity = parseInt(document.getElementById('quantity').value);

			if (!orderId || !price || !quantity) {
				showAlert('Please fill all fields', 'danger');
				return;
			}

			showLoading(true);
			try {
				const response = await fetch(API_URL + '/new', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ orderId, side, price, quantity })
				});

				const data = await response.json();
				if (response.ok) {
					showAlert('Order created! ' + data.fills.length + ' fills generated', 'success');
					document.getElementById('orderId').value = '';
					document.getElementById('price').value = '';
					document.getElementById('quantity').value = '';
					refreshOrderBook();
					refreshPosition();
				} else {
					showAlert(data.error, 'danger');
				}
			} catch (error) {
				showAlert(error.message, 'danger');
			} finally {
				showLoading(false);
			}
		}

		async function cancelOrder() {
			const orderId = document.getElementById('actionOrderId').value;

			if (!orderId) {
				showAlert('Please enter an Order ID', 'danger');
				return;
			}

			showLoading(true);
			try {
				const response = await fetch(API_URL + '/cancel', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ orderId })
				});

				const data = await response.json();
				if (response.ok) {
					showAlert('Order cancelled successfully', 'success');
					document.getElementById('actionOrderId').value = '';
					refreshOrderBook();
					refreshPosition();
				} else {
					showAlert(data.error, 'danger');
				}
			} catch (error) {
				showAlert(error.message, 'danger');
			} finally {
				showLoading(false);
			}
		}

		async function modifyOrder() {
			const orderId = document.getElementById('modifyOrderId').value;
			const newPrice = parseFloat(document.getElementById('modifyPrice').value);
			const newQuantity = parseInt(document.getElementById('modifyQuantity').value);

			if (!orderId || !newPrice || !newQuantity) {
				showAlert('Please fill all fields', 'danger');
				return;
			}

			showLoading(true);
			try {
				const response = await fetch(API_URL + '/modify', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ orderId, newPrice, newQuantity })
				});

				const data = await response.json();
				if (response.ok) {
					showAlert('Order modified! ' + data.fills.length + ' fills generated', 'success');
					document.getElementById('modifyOrderId').value = '';
					document.getElementById('modifyPrice').value = '';
					document.getElementById('modifyQuantity').value = '';
					refreshOrderBook();
					refreshPosition();
				} else {
					showAlert(data.error, 'danger');
				}
			} catch (error) {
				showAlert(error.message, 'danger');
			} finally {
				showLoading(false);
			}
		}

		async function setMarketPrice() {
			const currentPrice = parseFloat(document.getElementById('marketPrice').value);

			if (!currentPrice || currentPrice <= 0) {
				showAlert('Please enter a valid price', 'danger');
				return;
			}

			showLoading(true);
			try {
				const response = await fetch(API_URL + '/price', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ currentPrice })
				});

				const data = await response.json();
				if (response.ok) {
					showAlert('Market price set to ' + currentPrice, 'success');
					refreshPosition();
				} else {
					showAlert(data.error, 'danger');
				}
			} catch (error) {
				showAlert(error.message, 'danger');
			} finally {
				showLoading(false);
			}
		}

		async function createFill() {
			const buyOrderId = document.getElementById('fillBuyOrderId').value;
			const sellOrderId = document.getElementById('fillSellOrderId').value;
			const price = parseFloat(document.getElementById('fillPrice').value);
			const quantity = parseInt(document.getElementById('fillQuantity').value);

			if (!buyOrderId || !sellOrderId || !price || !quantity) {
				showAlert('Please fill all fields', 'danger');
				return;
			}

			showLoading(true);
			try {
				const response = await fetch(API_URL + '/fill', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ buyOrderId, sellOrderId, price, quantity })
				});

				const data = await response.json();
				if (response.ok) {
					showAlert('Fill recorded: ' + quantity + ' at ' + price, 'success');
					document.getElementById('fillBuyOrderId').value = '';
					document.getElementById('fillSellOrderId').value = '';
					document.getElementById('fillPrice').value = '';
					document.getElementById('fillQuantity').value = '';
					refreshOrderBook();
					refreshPosition();
				} else {
					showAlert(data.error, 'danger');
				}
			} catch (error) {
				showAlert(error.message, 'danger');
			} finally {
				showLoading(false);
			}
		}

		async function refreshPosition() {
			try {
				const response = await fetch(API_URL + '/position');
				const data = await response.json();

				if (response.ok) {
					document.getElementById('netQtyValue').textContent = data.netQty;
					document.getElementById('avgPriceValue').textContent = data.avgPrice.toFixed(2);
					document.getElementById('realizedPnLValue').textContent = data.realizedPnL.toFixed(2);
					document.getElementById('unrealizedPnLValue').textContent = data.unrealizedPnL.toFixed(2);
					document.getElementById('currentPriceValue').textContent = data.currentPrice.toFixed(2);

					const totalPnL = data.realizedPnL + data.unrealizedPnL;
					const totalPnLElement = document.getElementById('totalPnLValue');
					totalPnLElement.textContent = totalPnL.toFixed(2);
					totalPnLElement.className = 'metric-value ' + (totalPnL >= 0 ? 'pnl-positive' : 'pnl-negative');

					const unrealizedElement = document.getElementById('unrealizedPnLValue');
					unrealizedElement.className = 'metric-value ' + (data.unrealizedPnL >= 0 ? 'pnl-positive' : 'pnl-negative');

					const positionBadge = document.getElementById('positionBadge');
					if (data.netQty === 0) {
						positionBadge.textContent = 'FLAT';
						positionBadge.className = 'position-badge position-flat';
					} else if (data.netQty > 0) {
						positionBadge.textContent = 'LONG (' + data.netQty + ')';
						positionBadge.className = 'position-badge position-long';
					} else {
						positionBadge.textContent = 'SHORT (' + Math.abs(data.netQty) + ')';
						positionBadge.className = 'position-badge position-short';
					}
				}
			} catch (error) {
				console.error('Error refreshing position:', error.message);
			}
		}

		async function refreshOrderBook() {
			try {
				const response = await fetch(API_URL + '/book');
				const data = await response.json();

				if (response.ok) {
					displayBuyOrders(data.buyOrders);
					displaySellOrders(data.sellOrders);
					displayFills(data.fills);
				} else {
					showAlert('Failed to load order book', 'danger');
				}
			} catch (error) {
				showAlert(error.message, 'danger');
			}
		}

		function displayBuyOrders(orders) {
			const tbody = document.getElementById('buyOrdersTable');
			if (orders.length === 0) {
				tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No buy orders</td></tr>';
				return;
			}

			let html = '';
			for (let i = 0; i < orders.length; i++) {
				const order = orders[i];
				html += '<tr class="buy-row">';
				html += '<td><strong>' + order.orderId + '</strong></td>';
				html += '<td>' + order.price.toFixed(2) + '</td>';
				html += '<td>' + order.quantity + '</td>';
				html += '<td>' + order.filledQuantity + '</td>';
				html += '<td>' + order.remainingQuantity + '</td>';
				html += '<td>' + new Date(order.timestamp).toLocaleTimeString() + '</td>';
				html += '</tr>';
			}
			tbody.innerHTML = html;
		}

		function displaySellOrders(orders) {
			const tbody = document.getElementById('sellOrdersTable');
			if (orders.length === 0) {
				tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No sell orders</td></tr>';
				return;
			}

			let html = '';
			for (let i = 0; i < orders.length; i++) {
				const order = orders[i];
				html += '<tr class="sell-row">';
				html += '<td><strong>' + order.orderId + '</strong></td>';
				html += '<td>' + order.price.toFixed(2) + '</td>';
				html += '<td>' + order.quantity + '</td>';
				html += '<td>' + order.filledQuantity + '</td>';
				html += '<td>' + order.remainingQuantity + '</td>';
				html += '<td>' + new Date(order.timestamp).toLocaleTimeString() + '</td>';
				html += '</tr>';
			}
			tbody.innerHTML = html;
		}

		function displayFills(fills) {
			const tbody = document.getElementById('fillsTable');
			if (fills.length === 0) {
				tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No fills</td></tr>';
				return;
			}

			let html = '';
			for (let i = 0; i < fills.length; i++) {
				const fill = fills[i];
				html += '<tr>';
				html += '<td><span class="badge badge-buy">' + fill.buyOrderId + '</span></td>';
				html += '<td><span class="badge badge-sell">' + fill.sellOrderId + '</span></td>';
				html += '<td>' + fill.price.toFixed(2) + '</td>';
				html += '<td>' + fill.quantity + '</td>';
				html += '<td>' + new Date(fill.fillTime).toLocaleTimeString() + '</td>';
				html += '</tr>';
			}
			tbody.innerHTML = html;
		}

		// Load initial data on page load
		document.addEventListener('DOMContentLoaded', function () {
			refreshOrderBook();
			refreshPosition();
		});

		// Auto-refresh every 3 seconds
		setInterval(function () {
			refreshOrderBook();
			refreshPosition();
		}, 3000);
	</script>
</body>
</html>
