@page
@model WebApplication1.Pages.IndexModel
@{
	ViewData["Title"] = "Order Matching Engine";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>@ViewData["Title"]</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<style>
		body {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			min-height: 100vh;
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		}
		.main-container {
			padding: 20px;
		}
		.card {
			border: none;
			border-radius: 10px;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
			margin-bottom: 20px;
		}
		.card-header {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			color: white;
			border-radius: 10px 10px 0 0 !important;
			font-weight: 600;
		}
		.btn-primary {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			border: none;
			border-radius: 5px;
			padding: 8px 20px;
			transition: all 0.3s ease;
		}
		.btn-primary:hover {
			transform: translateY(-2px);
			box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
		}
		.btn-danger {
			border-radius: 5px;
			padding: 8px 15px;
		}
		.table {
			font-size: 0.95rem;
		}
		.table thead {
			background: #f8f9fa;
			font-weight: 600;
		}
		.buy-row {
			background-color: rgba(76, 175, 80, 0.1);
		}
		.sell-row {
			background-color: rgba(244, 67, 54, 0.1);
		}
		.alert-success {
			border-radius: 5px;
		}
		.alert-danger {
			border-radius: 5px;
		}
		.form-control, .form-select {
			border-radius: 5px;
			border: 1px solid #ddd;
		}
		.badge-buy {
			background-color: #4CAF50;
			color: white;
		}
		.badge-sell {
			background-color: #f44336;
			color: white;
		}
		.section-title {
			color: white;
			margin-bottom: 20px;
			font-weight: 700;
		}
		.loading {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background: rgba(0, 0, 0, 0.5);
			z-index: 9999;
			justify-content: center;
			align-items: center;
		}
		.loading.active {
			display: flex;
		}
		.spinner {
			border: 4px solid rgba(255, 255, 255, 0.3);
			border-top-color: white;
			border-radius: 50%;
			width: 40px;
			height: 40px;
			animation: spin 0.8s linear infinite;
		}
		@@keyframes spin {
			to { transform: rotate(360deg); }
		}
	</style>
</head>
<body>
	<div class="loading" id="loading">
		<div class="spinner"></div>
	</div>

	<div class="main-container">
		<div class="container-fluid">
			<!-- Header -->
			<div class="mb-4">
				<h1 class="section-title">📊 Order Matching Engine</h1>
			</div>

			<div class="row">
				<!-- Left Column: Order Management -->
				<div class="col-lg-6">
					<!-- New Order -->
					<div class="card">
						<div class="card-header">
							➕ Create New Order
						</div>
						<div class="card-body">
							<div class="mb-3">
								<label class="form-label">Order ID</label>
								<input type="text" class="form-control" id="orderId" placeholder="e.g., ORD001">
							</div>
							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label">Side</label>
									<select class="form-select" id="side">
										<option value="BUY">🔵 BUY</option>
										<option value="SELL">🔴 SELL</option>
									</select>
								</div>
								<div class="col-md-6 mb-3">
									<label class="form-label">Price</label>
									<input type="number" class="form-control" id="price" placeholder="100.00" step="0.01">
								</div>
							</div>
							<div class="mb-3">
								<label class="form-label">Quantity</label>
								<input type="number" class="form-control" id="quantity" placeholder="1000" step="1">
							</div>
							<button class="btn btn-primary w-100" onclick="createOrder()">Create Order</button>
						</div>
					</div>

					<!-- Order Actions -->
					<div class="card">
						<div class="card-header">
							⚙️ Order Actions
						</div>
						<div class="card-body">
							<div class="mb-3">
								<label class="form-label">Order ID</label>
								<input type="text" class="form-control" id="actionOrderId" placeholder="e.g., ORD001">
							</div>
							<button class="btn btn-danger w-100 mb-2" onclick="cancelOrder()">❌ Cancel Order</button>
						</div>
					</div>

					<!-- Modify Order -->
					<div class="card">
						<div class="card-header">
							✏️ Modify Order
						</div>
						<div class="card-body">
							<div class="mb-3">
								<label class="form-label">Order ID</label>
								<input type="text" class="form-control" id="modifyOrderId" placeholder="e.g., ORD001">
							</div>
							<div class="row">
								<div class="col-md-6 mb-3">
									<label class="form-label">New Price</label>
									<input type="number" class="form-control" id="modifyPrice" placeholder="100.00" step="0.01">
								</div>
								<div class="col-md-6 mb-3">
									<label class="form-label">New Quantity</label>
									<input type="number" class="form-control" id="modifyQuantity" placeholder="1000" step="1">
								</div>
							</div>
							<button class="btn btn-primary w-100" onclick="modifyOrder()">Modify Order</button>
						</div>
					</div>
				</div>

				<!-- Right Column: Order Book Display -->
				<div class="col-lg-6">
					<!-- Order Book -->
					<div class="card">
						<div class="card-header d-flex justify-content-between align-items-center">
							📋 Order Book
							<button class="btn btn-sm btn-light" onclick="refreshOrderBook()">🔄 Refresh</button>
						</div>
						<div class="card-body">
							<ul class="nav nav-tabs" role="tablist">
								<li class="nav-item">
									<a class="nav-link active" data-bs-toggle="tab" href="#buyOrders">BUY Orders</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" data-bs-toggle="tab" href="#sellOrders">SELL Orders</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" data-bs-toggle="tab" href="#fills">Fills</a>
								</li>
							</ul>

							<div class="tab-content mt-3">
								<!-- BUY Orders Tab -->
								<div class="tab-pane fade show active" id="buyOrders">
									<div class="table-responsive">
										<table class="table table-sm table-hover">
											<thead>
												<tr>
													<th>Order ID</th>
													<th>Price</th>
													<th>Qty</th>
													<th>Filled</th>
													<th>Remaining</th>
													<th>Time</th>
												</tr>
											</thead>
											<tbody id="buyOrdersTable">
												<tr>
													<td colspan="6" class="text-center text-muted">No buy orders</td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>

								<!-- SELL Orders Tab -->
								<div class="tab-pane fade" id="sellOrders">
									<div class="table-responsive">
										<table class="table table-sm table-hover">
											<thead>
												<tr>
													<th>Order ID</th>
													<th>Price</th>
													<th>Qty</th>
													<th>Filled</th>
													<th>Remaining</th>
													<th>Time</th>
												</tr>
											</thead>
											<tbody id="sellOrdersTable">
												<tr>
													<td colspan="6" class="text-center text-muted">No sell orders</td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>

								<!-- Fills Tab -->
								<div class="tab-pane fade" id="fills">
									<div class="table-responsive">
										<table class="table table-sm table-hover">
											<thead>
												<tr>
													<th>Buy Order</th>
													<th>Sell Order</th>
													<th>Price</th>
													<th>Quantity</th>
													<th>Time</th>
												</tr>
											</thead>
											<tbody id="fillsTable">
												<tr>
													<td colspan="5" class="text-center text-muted">No fills</td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Alerts -->
					<div id="alertContainer"></div>
				</div>
			</div>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		const API_URL = '/api/orders';

		function showLoading(show = true) {
			const loading = document.getElementById('loading');
			if (show) {
				loading.classList.add('active');
			} else {
				loading.classList.remove('active');
			}
		}

		function showAlert(message, type = 'success') {
			const alertContainer = document.getElementById('alertContainer');
			const alertId = 'alert-' + Date.now();
			const alert = `
				<div class="alert alert-${type} alert-dismissible fade show" role="alert" id="${alertId}">
					${message}
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
			`;
			alertContainer.insertAdjacentHTML('beforeend', alert);

			setTimeout(() => {
				const element = document.getElementById(alertId);
				if (element) {
					element.remove();
				}
			}, 5000);
		}

		async function createOrder() {
			const orderId = document.getElementById('orderId').value;
			const side = document.getElementById('side').value;
			const price = parseFloat(document.getElementById('price').value);
			const quantity = parseInt(document.getElementById('quantity').value);

			if (!orderId || !price || !quantity) {
				showAlert('Please fill all fields', 'danger');
				return;
			}

			showLoading(true);
			try {
				const response = await fetch(`${API_URL}/new`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ orderId, side, price, quantity })
				});

				const data = await response.json();
				if (response.ok) {
					showAlert(`Order created! ${data.fills.length} fills generated`, 'success');
					document.getElementById('orderId').value = '';
					document.getElementById('price').value = '';
					document.getElementById('quantity').value = '';
					refreshOrderBook();
				} else {
					showAlert(data.error, 'danger');
				}
			} catch (error) {
				showAlert(error.message, 'danger');
			} finally {
				showLoading(false);
			}
		}

		async function cancelOrder() {
			const orderId = document.getElementById('actionOrderId').value;

			if (!orderId) {
				showAlert('Please enter an Order ID', 'danger');
				return;
			}

			showLoading(true);
			try {
				const response = await fetch(`${API_URL}/cancel`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ orderId })
				});

				const data = await response.json();
				if (response.ok) {
					showAlert('Order cancelled successfully', 'success');
					document.getElementById('actionOrderId').value = '';
					refreshOrderBook();
				} else {
					showAlert(data.error, 'danger');
				}
			} catch (error) {
				showAlert(error.message, 'danger');
			} finally {
				showLoading(false);
			}
		}

		async function modifyOrder() {
			const orderId = document.getElementById('modifyOrderId').value;
			const newPrice = parseFloat(document.getElementById('modifyPrice').value);
			const newQuantity = parseInt(document.getElementById('modifyQuantity').value);

			if (!orderId || !newPrice || !newQuantity) {
				showAlert('Please fill all fields', 'danger');
				return;
			}

			showLoading(true);
			try {
				const response = await fetch(`${API_URL}/modify`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ orderId, newPrice, newQuantity })
				});

				const data = await response.json();
				if (response.ok) {
					showAlert(`Order modified! ${data.fills.length} fills generated`, 'success');
					document.getElementById('modifyOrderId').value = '';
					document.getElementById('modifyPrice').value = '';
					document.getElementById('modifyQuantity').value = '';
					refreshOrderBook();
				} else {
					showAlert(data.error, 'danger');
				}
			} catch (error) {
				showAlert(error.message, 'danger');
			} finally {
				showLoading(false);
			}
		}

		async function refreshOrderBook() {
			showLoading(true);
			try {
				const response = await fetch(`${API_URL}/book`);
				const data = await response.json();

				if (response.ok) {
					displayBuyOrders(data.buyOrders);
					displaySellOrders(data.sellOrders);
					displayFills(data.fills);
				} else {
					showAlert('Failed to load order book', 'danger');
				}
			} catch (error) {
				showAlert(error.message, 'danger');
			} finally {
				showLoading(false);
			}
		}

		function displayBuyOrders(orders) {
			const tbody = document.getElementById('buyOrdersTable');
			if (orders.length === 0) {
				tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No buy orders</td></tr>';
				return;
			}

			tbody.innerHTML = orders.map(order => `
				<tr class="buy-row">
					<td><strong>${order.orderId}</strong></td>
					<td>${order.price.toFixed(2)}</td>
					<td>${order.quantity}</td>
					<td>${order.filledQuantity}</td>
					<td>${order.remainingQuantity}</td>
					<td>${new Date(order.timestamp).toLocaleTimeString()}</td>
				</tr>
			`).join('');
		}

		function displaySellOrders(orders) {
			const tbody = document.getElementById('sellOrdersTable');
			if (orders.length === 0) {
				tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No sell orders</td></tr>';
				return;
			}

			tbody.innerHTML = orders.map(order => `
				<tr class="sell-row">
					<td><strong>${order.orderId}</strong></td>
					<td>${order.price.toFixed(2)}</td>
					<td>${order.quantity}</td>
					<td>${order.filledQuantity}</td>
					<td>${order.remainingQuantity}</td>
					<td>${new Date(order.timestamp).toLocaleTimeString()}</td>
				</tr>
			`).join('');
		}

		function displayFills(fills) {
			const tbody = document.getElementById('fillsTable');
			if (fills.length === 0) {
				tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No fills</td></tr>';
				return;
			}

			tbody.innerHTML = fills.map(fill => `
				<tr>
					<td><span class="badge badge-buy">${fill.buyOrderId}</span></td>
					<td><span class="badge badge-sell">${fill.sellOrderId}</span></td>
					<td>${fill.price.toFixed(2)}</td>
					<td>${fill.quantity}</td>
					<td>${new Date(fill.fillTime).toLocaleTimeString()}</td>
				</tr>
			`).join('');
		}

		// Load initial order book on page load
		document.addEventListener('DOMContentLoaded', refreshOrderBook);

		// Auto-refresh every 3 seconds
		setInterval(refreshOrderBook, 3000);
	</script>
</body>
</html>
